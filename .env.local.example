# Copy to .env.local and fill in real values.
# Never commit .env.local.

# === Supabase ===
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by Drizzle for migrations. Prefer the *session pooler* connection
# string in Supabase (Project Settings → Database → Connection pooling).
# Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# === App ===
# Used by the magic-link / OAuth callback to know where to redirect back to.
# In production set this to your Vercel URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Email (Resend) ===
# Powers transactional booking notifications (PRD 14): new-request alerts to
# property admins, and approve/decline/cancel notices to the requester.
# OPTIONAL — when RESEND_API_KEY is unset the app no-ops (logs and skips) so
# local dev and previews keep working without email.
#   1. Create a key at https://resend.com → API Keys.
#   2. Verify your sending domain (e.g. mathiesonfamily.app) so RESEND_FROM_EMAIL
#      can use it. Until then, Resend's onboarding@resend.dev sender only
#      delivers to the Resend account owner's own address (fine for testing).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Mathieson Family <notifications@mathiesonfamily.app>"

# === Smart Intake (Claude vision) ===
# Powers "Add from a Photo" on a property (PRD 32): a photographed bill is read
# server-side and the existing contact form opens pre-filled for review.
# SERVER-SCOPE ONLY — never prefix with NEXT_PUBLIC_, never commit a real key.
# OPTIONAL — when ANTHROPIC_API_KEY is unset the entry point is hidden and the
# intake page explains it isn't set up, so local dev and previews keep working.
#   1. Create a key at https://console.anthropic.com → API Keys.
#   2. Add it in Vercel under Project Settings → Environment Variables.
# INTAKE_MODEL overrides the vision model. Default is claude-haiku-4-5,
# chosen by the eval in evals/intake/ (matches Sonnet on accuracy at realistic
# photo quality, ~4x cheaper). Re-run that eval before changing it.
# ANTHROPIC_API_KEY=
# INTAKE_MODEL=claude-haiku-4-5
